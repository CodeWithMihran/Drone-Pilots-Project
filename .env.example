# ==============================================================================
# Aether — Certified Commercial Drone Pilots for Industry Marketplace
# Environment Configuration Template
# ==============================================================================

# MongoDB Database Connection URI (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/drone_marketplace?retryWrites=true&w=majority

# Supabase Auth Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Application URL
NEXTAUTH_URL=http://localhost:3000

# Email Delivery / SMTP Configuration (Nodemailer - e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME="Certified Drone Pilots"
SMTP_FROM_EMAIL=your_email@gmail.com

# Cloudinary Storage for Certificates and Flight Media Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Google Maps API Key for mission geo-mapping
NEXT_PUBLIC_MAPS_API_KEY=
