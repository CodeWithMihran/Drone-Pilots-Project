# MongoDB Connection URI (e.g. mongodb://localhost:27017/drone_marketplace or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/drone_marketplace

# NextAuth Secret for signing JWTs & session cookies
AUTH_SECRET=super_secret_jwt_encryption_key_change_in_production_32char
NEXTAUTH_SECRET=super_secret_jwt_encryption_key_change_in_production_32char
NEXTAUTH_URL=http://localhost:3000

# Cloudinary Configuration for certificate & image uploads
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_api_secret_key

# Optional Maps API Key (Graceful text fallback is used if missing)
NEXT_PUBLIC_MAPS_API_KEY=
